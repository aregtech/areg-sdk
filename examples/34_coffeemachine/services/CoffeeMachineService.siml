<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ServiceInterface FormatVersion="1.1.0">
    <Overview ID="1" Name="CoffeeMachineService" Version="1.0.0" Category="Public">
        <Description>Contract between a coffee machine and whoever drives it.</Description>
    </Overview>
    <DataTypeList>
        <DataType ID="2" Name="DrinkType" Type="Enumeration" Values="default">
            <Description>The three drinks the machine can make.</Description>
            <FieldList>
                <EnumEntry ID="3" Name="Espresso">
                    <Description>120 cents. Water 40 ml, beans 9 g, no milk.</Description>
                </EnumEntry>
                <EnumEntry ID="4" Name="Cappuccino">
                    <Description>180 cents. Water 60 ml, beans 9 g, milk 80 ml.</Description>
                </EnumEntry>
                <EnumEntry ID="5" Name="Latte">
                    <Description>200 cents. Water 60 ml, beans 9 g, milk 150 ml.</Description>
                </EnumEntry>
            </FieldList>
        </DataType>
        <DataType ID="6" Name="MakingStage" Type="Enumeration" Values="default">
            <Description>Where the machine is while a drink is being made.</Description>
            <FieldList>
                <EnumEntry ID="7" Name="Idle">
                    <Description>No drink is being made.</Description>
                </EnumEntry>
                <EnumEntry ID="8" Name="Grinding">
                    <Description>Grinding the beans.</Description>
                </EnumEntry>
                <EnumEntry ID="9" Name="Heating">
                    <Description>Heating the water.</Description>
                </EnumEntry>
                <EnumEntry ID="10" Name="Brewing">
                    <Description>Brewing.</Description>
                </EnumEntry>
                <EnumEntry ID="11" Name="Frothing">
                    <Description>Frothing the milk. Only for Cappuccino and Latte.</Description>
                </EnumEntry>
                <EnumEntry ID="12" Name="Dispensing">
                    <Description>Dispensing the drink.</Description>
                </EnumEntry>
                <EnumEntry ID="13" Name="Paused">
                    <Description>The order was paused. Resuming continues in the stage it left.</Description>
                </EnumEntry>
            </FieldList>
        </DataType>
        <DataType ID="14" Name="TankType" Type="Enumeration" Values="default">
            <Description>The three tanks that can be refilled.</Description>
            <FieldList>
                <EnumEntry ID="15" Name="Water"/>
                <EnumEntry ID="16" Name="Beans"/>
                <EnumEntry ID="17" Name="Milk"/>
            </FieldList>
        </DataType>
    </DataTypeList>
    <AttributeList>
        <Attribute ID="18" Name="Credit" DataType="uint32" Notify="OnChange">
            <Description>Credit accumulated from inserted coins, in cents.</Description>
        </Attribute>
        <Attribute ID="19" Name="Stage" DataType="MakingStage" Notify="OnChange">
            <Description>The current making stage. Idle when no drink is being made.</Description>
        </Attribute>
    </AttributeList>
    <MethodList>
        <Method ID="20" Name="insert_coin" MethodType="Request">
            <Description>Insert a coin. Accepted denominations are 5, 10, 20, 50, 100 and 200 cents; anything else is ignored.</Description>
            <ParamList>
                <Parameter ID="21" Name="value" DataType="uint32">
                    <Description>The coin value, in cents.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="22" Name="order_drink" MethodType="Request" Response="order_drink">
            <Description>Ask the machine to make a drink. Accepted only when the credit covers the price and every ingredient it needs is available.</Description>
            <ParamList>
                <Parameter ID="23" Name="drink" DataType="DrinkType">
                    <Description>The drink to make.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="24" Name="order_drink" MethodType="Response">
            <Description>Whether the order was accepted.</Description>
            <ParamList>
                <Parameter ID="25" Name="accepted" DataType="bool">
                    <Description>True when the machine started making the drink.</Description>
                </Parameter>
                <Parameter ID="26" Name="reason" DataType="String">
                    <Description>Empty when accepted. Otherwise the refusal reason: "insufficient credit", or the missing ingredient's name.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="27" Name="pause_drink" MethodType="Request">
            <Description>Pause the drink being made. Has no effect when nothing is being made.</Description>
        </Method>
        <Method ID="28" Name="resume_drink" MethodType="Request">
            <Description>Resume a paused drink from the stage it was interrupted in.</Description>
        </Method>
        <Method ID="29" Name="cancel_order" MethodType="Request" Response="cancel_order">
            <Description>Cancel: before an order, or while one is being made. Returns the whole credit either way. Ingredients already consumed are not returned.</Description>
        </Method>
        <Method ID="30" Name="cancel_order" MethodType="Response">
            <Description>The result of the cancellation.</Description>
            <ParamList>
                <Parameter ID="31" Name="refunded" DataType="uint32">
                    <Description>The whole credit, returned in cents.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="32" Name="refill_tank" MethodType="Request">
            <Description>Refill the named tank to full.</Description>
            <ParamList>
                <Parameter ID="33" Name="tank" DataType="TankType">
                    <Description>The tank to refill.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="34" Name="ingredient_low" MethodType="Broadcast">
            <Description>Sent once when a tank falls below 20 percent, not repeated while it stays there.</Description>
            <ParamList>
                <Parameter ID="35" Name="ingredient" DataType="String">
                    <Description>"water", "beans" or "milk".</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="36" Name="ingredient_empty" MethodType="Broadcast">
            <Description>Sent once when a tank reaches zero, not repeated while it stays there.</Description>
            <ParamList>
                <Parameter ID="37" Name="ingredient" DataType="String">
                    <Description>"water", "beans" or "milk".</Description>
                </Parameter>
            </ParamList>
        </Method>
    </MethodList>
    <ConstantList>
        <Constant ID="38" Name="PriceEspresso" DataType="uint32" Value="120">
            <Description>Espresso price, in cents.</Description>
        </Constant>
        <Constant ID="39" Name="PriceCappuccino" DataType="uint32" Value="180">
            <Description>Cappuccino price, in cents.</Description>
        </Constant>
        <Constant ID="40" Name="PriceLatte" DataType="uint32" Value="200">
            <Description>Latte price, in cents.</Description>
        </Constant>
        <Constant ID="41" Name="TankCapacityWater" DataType="uint32" Value="2000">
            <Description>Water tank capacity, in millilitres.</Description>
        </Constant>
        <Constant ID="42" Name="TankCapacityBeans" DataType="uint32" Value="500">
            <Description>Bean tank capacity, in grams.</Description>
        </Constant>
        <Constant ID="43" Name="TankCapacityMilk" DataType="uint32" Value="1000">
            <Description>Milk tank capacity, in millilitres.</Description>
        </Constant>
    </ConstantList>
</ServiceInterface>
