    <MethodList>
        <Method ID="1100" Name="message_next" MethodType="Request">
            <Description>Pull token for the one-way trip. The consumer calls it to ask the provider for exactly one broadcast of the given size. The provider never sends on its own, so the test can never run away and there is never more than one message in flight.</Description>
            <ParamList>
                <Parameter ID="1101" Name="mode" DataType="LatencyMode">
                    <Description>Which broadcast to emit. Only the Broadcast* values are accepted; any other value is ignored.</Description>
                </Parameter>
                <Parameter ID="1102" Name="id" DataType="uint32">
                    <Description>Sequence number of the message the consumer expects. Used only to detect lost messages.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="1110" Name="message_0" MethodType="Broadcast">
            <Description>One-way message, id and send timestamp only.</Description>
            <ParamList>
                <Parameter ID="1111" Name="id" DataType="uint32">
                    <Description>Sequence number stamped by the provider.</Description>
                </Parameter>
                <Parameter ID="1112" Name="begin" DataType="uint64">
                    <Description>Send timestamp in nanoseconds, taken by the provider.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="1113" Name="message_8" MethodType="Broadcast">
