<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ServiceInterface FormatVersion="1.1.0">
    <Overview ID="1000" Name="LocalLatency" Version="1.0.0" Category="Private">
        <Description>Local (in-process) latency benchmark service. The service is Private, so the provider and the consumer always live in the same process and the messages never reach the message router. This is the counterpart of the Public "Latency" interface used by example 30.</Description>
    </Overview>
    <DataTypeList>
        <DataType ID="1001" Name="LatencyMode" Type="Enumeration" Values="uint16">
            <Description>Selects which message is measured. The names and the order are identical to the "Latency" interface of example 30, so the results of the two examples can be compared one to one.</Description>
            <FieldList>
                <EnumEntry ID="1002" Name="Stop">
                    <Value>0</Value>
                    <Description>No measurement is running.</Description>
                </EnumEntry>
                <EnumEntry ID="1003" Name="Broadcast0">
                    <Description>One-way trip, id and timestamp only, no extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1004" Name="Broadcast8">
                    <Description>One-way trip, plus 8 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1005" Name="Broadcast16">
                    <Description>One-way trip, plus 16 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1006" Name="Broadcast32">
                    <Description>One-way trip, plus 32 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1007" Name="Broadcast64">
                    <Description>One-way trip, plus 64 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1008" Name="Broadcast128">
                    <Description>One-way trip, plus 128 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1009" Name="Broadcast256">
                    <Description>One-way trip, plus 256 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1010" Name="Broadcast512">
                    <Description>One-way trip, plus 512 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1011" Name="Broadcast1024">
                    <Description>One-way trip, plus 1024 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1012" Name="Broadcast4096">
                    <Description>One-way trip, plus 4096 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1013" Name="Broadcast65536">
                    <Description>One-way trip, plus 65536 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1014" Name="Request0">
                    <Description>Round trip (request and response), id and timestamp only.</Description>
                </EnumEntry>
                <EnumEntry ID="1015" Name="Request8">
                    <Description>Round trip, plus 8 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1016" Name="Request16">
                    <Description>Round trip, plus 16 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1017" Name="Request32">
                    <Description>Round trip, plus 32 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1018" Name="Request64">
                    <Description>Round trip, plus 64 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1019" Name="Request128">
                    <Description>Round trip, plus 128 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1020" Name="Request256">
                    <Description>Round trip, plus 256 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1021" Name="Request512">
                    <Description>Round trip, plus 512 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1022" Name="Request1024">
                    <Description>Round trip, plus 1024 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1023" Name="Request4096">
                    <Description>Round trip, plus 4096 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1024" Name="Request65536">
                    <Description>Round trip, plus 65536 bytes of extra data.</Description>
                </EnumEntry>
                <EnumEntry ID="1025" Name="Undefined">
                    <Description>The mode is not known. Returned when a mode name cannot be parsed.</Description>
                </EnumEntry>
            </FieldList>
        </DataType>
