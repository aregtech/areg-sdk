<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ServiceInterface FormatVersion="1.1.0">
    <Overview ID="1" Name="ReportService" Version="1.0.0" Category="Private">
        <Description>Reports a meter value that has been checked.</Description>
    </Overview>
    <AttributeList>
        <Attribute ID="2" Name="Report" DataType="uint32" Notify="OnChange">
            <Description>The last reading that was accepted. An attribute, not a broadcast: a subscriber is sent the current value when it subscribes, where a broadcast is only heard by whoever is already listening.</Description>
        </Attribute>
    </AttributeList>
</ServiceInterface>
