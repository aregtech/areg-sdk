<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ServiceInterface FormatVersion="1.1.0">
    <Overview ID="1" Name="ReportService" Version="1.0.0" Category="Private">
        <Description>Reports a reading that has been checked.</Description>
    </Overview>
    <MethodList>
        <Method ID="2" Name="report" MethodType="Broadcast">
            <Description>Sent when a new reading has been accepted.</Description>
            <ParamList>
                <Parameter ID="3" Name="reading" DataType="SharedTypes::Reading">
                    <Description>The accepted reading, in the shared structure.</Description>
                </Parameter>
            </ParamList>
        </Method>
    </MethodList>
    <IncludeList>
        <Location ID="4" Name="src/services/SharedTypes.dtml">
            <Description>The structure this service shares with MeterService.</Description>
        </Location>
    </IncludeList>
</ServiceInterface>
