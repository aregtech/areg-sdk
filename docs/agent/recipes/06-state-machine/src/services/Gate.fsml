<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<StateMachine FormatVersion="1.2.0">
    <Overview ID="1" Name="Gate" Version="1.0.0" Threading="Local">
        <Description>A gate that opens to a requested width, can be held part way through its cycle, and refuses a width it cannot reach.</Description>
    </Overview>
    <AttributeList>
        <Attribute ID="2" Name="Width" DataType="uint32" Value="0">
            <Description>The width the last accepted request asked for.</Description>
        </Attribute>
    </AttributeList>
    <EventList>
        <Event ID="3" Name="Cycled">
            <Description>Sent by GATE_CYCLE when its own level reaches Final.</Description>
        </Event>
        <Event ID="4" Name="Refused">
            <Description>Sent when a request asks for more than MaxWidth.</Description>
        </Event>
    </EventList>
    <TimerList>
        <Timer ID="5" Name="Warn" Timeout="200" Repeat="1">
            <Description>How long the gate warns before it is fully open.</Description>
        </Timer>
        <Timer ID="6" Name="Hold" Timeout="300" Repeat="1">
            <Description>How long the gate stays open.</Description>
        </Timer>
    </TimerList>
    <MethodList>
        <Method ID="7" Name="open" MethodType="Trigger">
            <Description>Asks the gate to open to a width.</Description>
            <ParamList>
                <Parameter ID="8" Name="width" DataType="uint32">
                    <Description>The width asked for, in centimetres.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="9" Name="hold" MethodType="Trigger">
            <Description>Interrupts the cycle wherever it is.</Description>
        </Method>
        <Method ID="10" Name="resume" MethodType="Trigger">
            <Description>Continues the cycle from where it was interrupted.</Description>
        </Method>
        <Method ID="11" Name="on_opening" MethodType="Action">
            <Description>Runs on entering the opening stage.</Description>
        </Method>
        <Method ID="12" Name="on_open" MethodType="Action">
            <Description>Runs on entering the open stage.</Description>
        </Method>
        <Method ID="13" Name="on_held" MethodType="Action">
            <Description>Runs when the cycle is interrupted.</Description>
        </Method>
        <Method ID="14" Name="on_closed" MethodType="Action">
            <Description>Runs when a whole cycle has finished.</Description>
        </Method>
        <Method ID="15" Name="on_refused" MethodType="Action">
            <Description>Runs when a request asks for a width the gate cannot reach.</Description>
            <ParamList>
                <Parameter ID="49" Name="asked" DataType="uint32">
                    <Description>The width that was refused.</Description>
                </Parameter>
            </ParamList>
        </Method>
        <Method ID="16" Name="on_stopped" MethodType="Action">
            <Description>Runs once, when the machine stops.</Description>
        </Method>
    </MethodList>
    <ConstantList>
        <Constant ID="17" Name="MaxWidth" DataType="uint32" Value="100">
            <Description>The widest opening the gate can reach.</Description>
        </Constant>
    </ConstantList>
    <StateList>
        <State ID="18" Name="Start" Kind="Start">
            <TransitionList>
                <Transition ID="19" Kind="Initial" To="20"/>
            </TransitionList>
        </State>
        <State ID="20" Name="GATE_CLOSED" Kind="Normal">
            <Description>Shut, waiting for a request. Document order is priority order: the guarded transition is tried first, the internal one catches what it refuses.</Description>
            <TransitionList>
                <Transition ID="21" Kind="External" StimulusKind="Trigger" Stimulus="open" To="26">
                    <Guard state="ok">
                        <Expr>
                            <Cmp op="le"><Param id="8"/><Const id="17"/></Cmp>
                        </Expr>
                    </Guard>
                    <OperationList>
                        <AttributeSet ID="22" Attribute="Width" Source="Param" Value="width"/>
                    </OperationList>
                </Transition>
                <Transition ID="23" Kind="Internal" StimulusKind="Trigger" Stimulus="open">
                    <Description>Too wide. The state is not left; the operations run in place.</Description>
                    <OperationList>
                        <ActionCall ID="24" Action="on_refused">
                            <ArgumentList>
                                <Argument ID="50" Name="asked" Source="Param" Value="width"/>
                            </ArgumentList>
                        </ActionCall>
                        <EventSend ID="25" Event="Refused"/>
                    </OperationList>
                </Transition>
                <Transition ID="40" Kind="External" StimulusKind="Event" Stimulus="Refused" To="41"/>
            </TransitionList>
        </State>
        <State ID="26" Name="GATE_CYCLE" Kind="Normal" OnFinal="Cycled">
            <Description>Composite: one opening cycle. A transition naming its history marker resumes the stage a hold interrupted; a transition naming the composite itself descends the Start chain and begins a new cycle.</Description>
            <ExitList>
                <TimerStop ID="27" Timer="Warn"/>
                <TimerStop ID="28" Timer="Hold"/>
            </ExitList>
            <TransitionList>
                <Transition ID="29" Kind="External" StimulusKind="Trigger" Stimulus="hold" To="38"/>
                <Transition ID="30" Kind="External" StimulusKind="Event" Stimulus="Cycled" To="20">
                    <OperationList>
                        <ActionCall ID="31" Action="on_closed"/>
                    </OperationList>
                </Transition>
            </TransitionList>
            <StateList>
                <State ID="200" Name="CycleHistory" Kind="History" HistoryDepth="Shallow">
                    <Description>The marker resume targets. Shallow re-activates the direct substate the level was left in.</Description>
                </State>
                <State ID="32" Name="Start2" Kind="Start">
                    <TransitionList>
                        <Transition ID="33" Kind="Initial" To="34"/>
                    </TransitionList>
                </State>
                <State ID="34" Name="GATE_OPENING" Kind="Normal">
                    <Description>Moving. Runs once per cycle.</Description>
                    <EntryList>
                        <TimerStart ID="35" Timer="Warn"/>
                        <ActionCall ID="36" Action="on_opening"/>
                    </EntryList>
                    <TransitionList>
                        <Transition ID="37" Kind="External" StimulusKind="Timer" Stimulus="Warn" To="42"/>
                    </TransitionList>
                </State>
                <State ID="42" Name="GATE_OPEN" Kind="Normal">
                    <Description>Fully open, holding.</Description>
                    <EntryList>
                        <TimerStart ID="43" Timer="Hold"/>
                        <ActionCall ID="44" Action="on_open"/>
                    </EntryList>
                    <TransitionList>
                        <Transition ID="45" Kind="External" StimulusKind="Timer" Stimulus="Hold" To="46"/>
                    </TransitionList>
                </State>
                <State ID="46" Name="GATE_SHUT" Kind="Final">
                    <Description>This level is done. OnFinal turns that into the Cycled event GATE_CYCLE transitions on.</Description>
                </State>
            </StateList>
        </State>
        <State ID="38" Name="GATE_HELD" Kind="Normal">
            <Description>The cycle is interrupted. Resume names the history marker, so it re-enters the stage the hold interrupted.</Description>
            <EntryList>
                <ActionCall ID="39" Action="on_held"/>
            </EntryList>
            <TransitionList>
                <Transition ID="47" Kind="External" StimulusKind="Trigger" Stimulus="resume" To="200"/>
            </TransitionList>
        </State>
        <State ID="41" Name="GATE_DONE" Kind="Final">
            <Description>The machine stops here and reports through the final observer.</Description>
            <EntryList>
                <ActionCall ID="48" Action="on_stopped"/>
            </EntryList>
        </State>
    </StateList>
</StateMachine>
